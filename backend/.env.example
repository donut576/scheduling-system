PORT=3000
# 例：postgres://帳號:密碼@localhost:5432/scheduling
DATABASE_URL=postgres://postgres:postgres@localhost:5432/scheduling
# 前端開發網址（CORS 白名單）
CORS_ORIGIN=http://localhost:5173
# 簽發登入 token 的密鑰（正式環境請換成長隨機字串）
JWT_SECRET=dev-only-secret-change-me
# 登入有效秒數（預設 2 小時）
TOKEN_TTL_SEC=7200
# 暫時固定登入（admin/manager/leader/staff/TPA02）；只在開發環境設為 true
ENABLE_DEV_LOGIN=true
