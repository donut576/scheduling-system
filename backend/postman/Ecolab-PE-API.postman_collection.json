{
  "info": {
    "name": "Ecolab PE 排班系統 API",
    "description": "依前端 src/api 與 MSW 整理的 API 草稿（共 34 支）。路徑與回應格式 {code,message,data} 取自前端現況；請求內容為空的項目，待後端定案後補範例。先執行「登入」，token 會自動存入環境變數。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "登入",
      "item": [
        {
          "name": "登入",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account\": \"請填員工編號\",\n  \"password\": \"請填密碼\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.code === 0 && j.data && j.data.token) { pm.environment.set('token', j.data.token); }",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('code 為 0（成功）', () => pm.expect(pm.response.json().code).to.eql(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "目前使用者資料",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "profile"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('code 為 0（成功）', () => pm.expect(pm.response.json().code).to.eql(0));"
                ]
              }
            }
          ]
        }
      ]
    },
