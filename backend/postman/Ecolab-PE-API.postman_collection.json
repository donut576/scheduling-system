    {
      "name": "任務",
      "item": [
        {
          "name": "任務列表（依登入角色顯示不同範圍）",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('code 為 0（成功）', () => pm.expect(pm.response.json().code).to.eql(0));",
                  "pm.test('回傳分頁結構', () => {const d = pm.response.json().data; ['list','total','page','pageSize'].forEach(k => pm.expect(d).to.have.property(k)); pm.expect(d.list).to.be.an('array');});",
                  "const d = pm.response.json().data; if (d && d.list && d.list.length) { pm.environment.set('taskId', d.list[0].id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "任務詳情（先跑列表以帶入 taskId）",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks", "{{taskId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('code 為 0（成功）', () => pm.expect(pm.response.json().code).to.eql(0));",
                  "pm.test('id 與請求一致', () => pm.expect(pm.response.json().data.id).to.eql(pm.environment.get('taskId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "新增任務（先跑客戶列表以帶入 branchId）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branchId\": \"{{branchId}}\",\n  \"taskType\": \"CONTRACT\",\n  \"date\": \"2026-12-15\",\n  \"startTime\": \"09:00\",\n  \"endTime\": \"11:00\",\n  \"timeMode\": \"FIXED\",\n  \"headcount\": 1,\n  \"shift\": \"早班\",\n  \"route\": \"\",\n  \"contents\": [\n    \"P\",\n    \"R\"\n  ],\n  \"assignees\": [],\n  \"remarks\": \"Postman 測試\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('code 為 0（成功）', () => pm.expect(pm.response.json().code).to.eql(0));",
                  "const t = pm.response.json().data; pm.test('沒有指派人員時為未排班', () => pm.expect(t.status).to.eql('UNSCHEDULED'));",
                  "pm.environment.set('newTaskId', t.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "修改任務（用新增任務建立的 newTaskId）",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/{{newTaskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks", "{{newTaskId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"route\": \"A路\",\n  \"remarks\": \"Postman 修改\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('code 為 0（成功）', () => pm.expect(pm.response.json().code).to.eql(0));",
                  "pm.test('欄位已更新', () => pm.expect(pm.response.json().data.route).to.eql('A路'));"
                ]
              }
            }
          ]
        },
        {
          "name": "取消任務（status 改 CANCELLED，可帶取消原因）",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
