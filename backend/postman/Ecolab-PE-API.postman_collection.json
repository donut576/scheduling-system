{
  "info": {
    "name": "Ecolab PE 排班系統 API",
    "description": "依前端 src/api 與 MSW 整理的 API 草稿（共 35 支）。路徑與回應格式 {code,message,data} 取自前端現況；請求內容為空的項目，待後端定案後補範例。先執行「登入」，token 會自動存入環境變數。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "登入",
      "item": [
        {
          "name": "登入",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account\": \"admin\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.code === 0 && j.data && j.data.accessToken) { pm.environment.set('token', j.data.accessToken); }",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('code 為 0（成功）', () => pm.expect(pm.response.json().code).to.eql(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "目前使用者資料",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "profile"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('code 為 0（成功）', () => pm.expect(pm.response.json().code).to.eql(0));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "字典",
      "item": [
        {
          "name": "字典（下拉選項）",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/dict",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "dict"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('code 為 0（成功）', () => pm.expect(pm.response.json().code).to.eql(0));",
                  "pm.test('內容、班別、證照、職位都有資料', () => {const d = pm.response.json().data; ['contents','shifts','licenses','positions'].forEach(k => pm.expect(d[k].length).to.be.above(0));});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "任務",
      "item": [
        {
          "name": "任務列表（依登入角色顯示不同範圍）",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('code 為 0（成功）', () => pm.expect(pm.response.json().code).to.eql(0));",
                  "pm.test('回傳分頁結構', () => {const d = pm.response.json().data; ['list','total','page','pageSize'].forEach(k => pm.expect(d).to.have.property(k)); pm.expect(d.list).to.be.an('array');});",
                  "const d = pm.response.json().data; if (d && d.list && d.list.length) { pm.environment.set('taskId', d.list[0].id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "任務詳情（先跑列表以帶入 taskId）",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks", "{{taskId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('code 為 0（成功）', () => pm.expect(pm.response.json().code).to.eql(0));",
                  "pm.test('id 與請求一致', () => pm.expect(pm.response.json().data.id).to.eql(pm.environment.get('taskId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "新增任務（先跑客戶列表以帶入 branchId）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branchId\": \"{{branchId}}\",\n  \"taskType\": \"CONTRACT\",\n  \"date\": \"2026-12-15\",\n  \"startTime\": \"09:00\",\n  \"endTime\": \"11:00\",\n  \"timeMode\": \"FIXED\",\n  \"headcount\": 1,\n  \"shift\": \"早班\",\n  \"route\": \"\",\n  \"contents\": [\n    \"P\",\n    \"R\"\n  ],\n  \"assignees\": [],\n  \"remarks\": \"Postman 測試\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('code 為 0（成功）', () => pm.expect(pm.response.json().code).to.eql(0));",
                  "const t = pm.response.json().data; pm.test('沒有指派人員時為未排班', () => pm.expect(t.status).to.eql('UNSCHEDULED'));",
                  "pm.environment.set('newTaskId', t.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "修改任務（用新增任務建立的 newTaskId）",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/{{newTaskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks", "{{newTaskId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"route\": \"A路\",\n  \"remarks\": \"Postman 修改\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('code 為 0（成功）', () => pm.expect(pm.response.json().code).to.eql(0));",
                  "pm.test('欄位已更新', () => pm.expect(pm.response.json().data.route).to.eql('A路'));"
                ]
              }
            }
          ]
        },
        {
          "name": "取消任務（status 改 CANCELLED，可帶取消原因）",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/{{newTaskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks", "{{newTaskId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CANCELLED\",\n  \"remarks\": \"颱風停班（Postman 測試）\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('code 為 0（成功）', () => pm.expect(pm.response.json().code).to.eql(0));",
                  "pm.test('狀態為已取消', () => pm.expect(pm.response.json().data.status).to.eql('CANCELLED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "任務預檢（修改前；body 沒帶的欄位用資料庫現有的值，只檢查不寫入）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/{{taskId}}/validate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks", "{{taskId}}", "validate"]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('code 為 0（成功）', () => pm.expect(pm.response.json().code).to.eql(0));",
                  "const d = pm.response.json().data;",
                  "pm.test('回傳 isValid、violations、canOverride', () => { pm.expect(d.isValid).to.be.a('boolean'); pm.expect(d.violations).to.be.an('array'); pm.expect(d.canOverride).to.be.a('boolean'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "新增任務預檢（還沒有 id；先跑客戶列表、員工列表；只檢查不寫入）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/validate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks", "validate"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branchId\": \"{{branchId}}\",\n  \"taskType\": \"CONTRACT\",\n  \"date\": \"2031-03-17\",\n  \"startTime\": \"09:00\",\n  \"endTime\": \"11:00\",\n  \"timeMode\": \"FIXED\",\n  \"headcount\": 2,\n  \"assignees\": [\"{{employeeId}}\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('回傳 isValid、violations、canOverride', () => { pm.expect(d.isValid).to.be.a('boolean'); pm.expect(d.violations).to.be.an('array'); pm.expect(d.canOverride).to.be.a('boolean'); });",
                  "pm.test('人數 2、只指派 1 人 → 有「人數不足」', () => pm.expect(d.violations.map(x => x.ruleId)).to.include('HEADCOUNT_BELOW_MIN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "新增任務（有警示要帶特許備註；先跑員工列表）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branchId\": \"{{branchId}}\",\n  \"taskType\": \"CONTRACT\",\n  \"date\": \"2031-03-17\",\n  \"startTime\": \"09:00\",\n  \"endTime\": \"11:00\",\n  \"timeMode\": \"FIXED\",\n  \"headcount\": 2,\n  \"shift\": \"早班\",\n  \"contents\": [\"P\"],\n  \"assignees\": [\"{{employeeId}}\"],\n  \"overrideRemark\": \"Postman 特許測試\",\n  \"remarks\": \"Postman 特許測試\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200（有特許權限）', () => pm.response.to.have.status(200));",
                  "const t = pm.response.json().data;",
                  "pm.test('人數不足但帶了特許備註 → 警示狀態 OVERRIDDEN', () => pm.expect(t.alertStatus).to.eql('OVERRIDDEN'));",
                  "pm.environment.set('overrideTaskId', t.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "新增任務（有警示但沒帶特許備註 → 預期 422）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branchId\": \"{{branchId}}\",\n  \"taskType\": \"CONTRACT\",\n  \"date\": \"2031-03-18\",\n  \"startTime\": \"09:00\",\n  \"endTime\": \"11:00\",\n  \"timeMode\": \"FIXED\",\n  \"headcount\": 2,\n  \"shift\": \"早班\",\n  \"contents\": [\"P\"],\n  \"assignees\": [\"{{employeeId}}\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 422', () => pm.response.to.have.status(422));",
                  "const r = pm.response.json();",
                  "pm.test('錯誤碼為 42202（排班衝突）或 42203（證照衝突）', () => pm.expect([42202, 42203]).to.include(r.code));",
                  "pm.test('data.errors 列出違規項目', () => pm.expect(r.data.errors).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "覆蓋警示（補特許備註；任務目前必須有警示，否則 422；先跑「新增任務（有警示要帶特許備註）」）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/{{overrideTaskId}}/override-warning",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks", "{{overrideTaskId}}", "override-warning"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"remark\": \"主管同意，補充特許原因\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('code 為 0（成功）', () => pm.expect(pm.response.json().code).to.eql(0));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "排班",
      "item": [
        {
          "name": "查詢班表：客戶維度（依登入角色顯示不同範圍）",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/schedule?dimension=customer&startDate=2026-11-01&endDate=2026-11-30",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "schedule"],
              "query": [
                {
                  "key": "dimension",
                  "value": "customer"
                },
                {
                  "key": "startDate",
                  "value": "2026-11-01"
                },
