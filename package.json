    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/resource": "^6.1.21",
    "@fullcalendar/resource-timeline": "^6.1.21",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "antd": "^5.22.0",
    "axios": "^1.19.0",
    "dayjs": "^1.11.21",
    "i18next": "^26.3.6",
    "leaflet": "1.9.4",
    "nprogress": "0.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
