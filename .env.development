VITE_API_BASE_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000
VITE_APP_TITLE=藝康排班系統
VITE_UPLOAD_MAX_SIZE=10485760

# Set to "false" once a real backend is running at VITE_API_BASE_URL.
# When "true", API calls are intercepted by MSW (src/mocks/browser.ts) so the
# app is demo-able without a backend. Demo admin login: admin / admin123
VITE_USE_MOCK_API=true
